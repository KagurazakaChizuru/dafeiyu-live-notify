{
  "onebot": {
    "base_url": "http://127.0.0.1:3000",
    "access_token": "",
    "timeout": 10
  },
  "groups": [
    {
      "group_id": 123456789,
      "enabled": true,
      "at_all": true,
      "at_list": [],
      "note": "改成你自己的群号"
    }
  ],
  "watch": {
    "enabled": true,
    "interval_seconds": 5,
    "processes": [
      "obs64.exe",
      "直播伴侣.exe",
      "livehime.exe"
    ],
    "confirm_checks": 2,
    "stop_grace_seconds": 60
  },
  "message": {
    "template": "🔴 开播了！\n\n{title}\n正在玩《{game}》\n{link}\n\n大家快来捧场～",
    "templates": [],
    "title": "今晚直播",
    "link": "https://live.bilibili.com/YOUR_ROOM_ID",
    "cover": true,
    "cover_size": [200, 112]
  },
  "game": {
    "enabled": true,
    "names": {
      "farcry6.exe": "孤岛惊魂6"
    },
    "ignore": [
      "vtube studio.exe"
    ],
    "announce_change": true,
    "change_template": "换游戏了，现在打《{game}》",
    "change_cooldown_minutes": 5
  },
  "reminder": {
    "enabled": true,
    "after_minutes": [30, 60],
    "max_total": 3,
    "template": "还在播～\n\n{title}\n正在玩《{game}》\n{link}",
    "at_all": false
  },
  "offline_message": {
    "enabled": true,
    "template": "🌙 下播啦，今晚播了 {duration}\n\n谢谢大家陪播～",
    "at_all": false,
    "grace_seconds": 60
  },
  "behavior": {
    "cooldown_minutes": 30,
    "test_target": "",
    "send_interval_seconds": 3,
    "dry_run": false,
    "auto_start": false
  },
  "trigger": {
    "on_platform_live": true,
    "on_obs_stream": true,
    "on_process_start": false,
    "hotkey": "ctrl+alt+k",
    "room_id": null,
    "poll_seconds": 30,
    "platform_proxy": ""
  },
  "control": {
    "enabled": true,
    "port": 8899,
    "token": ""
  },
  "ui": {
    "theme": "light"
  }
}
